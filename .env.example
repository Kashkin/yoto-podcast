# Folder holding your Yoto library (Stories/, Songs/, Non-fiction/, Cover images/, Labels/)
YOTO_LIBRARY=~/Library/CloudStorage/Box-Box/Yoto

# Tinker Icons key (https://developers.tinker.audio), or an op:// reference to it in 1Password
TINKER_API_KEY=
# Which 1Password account op reads from, if you have more than one (e.g. my.1password.com)
# OP_ACCOUNT=
